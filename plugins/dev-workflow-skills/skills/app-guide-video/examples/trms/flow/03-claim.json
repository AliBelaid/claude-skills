{ "name": "03-claim", "steps": [
  { "goto": "/app/mail-review/claims/new" },
  { "caption": { "en": "Step 2 — Create a claim for the patient", "ar": "الخطوة 2 — إنشاء مطالبة للمريض" }, "ms": 2000 },
  { "fill": { "placeholder": "رقم الهوية الوطنية" }, "value": "${NID}" },
  { "click": { "selector": "button:text-is(\"بحث\") >> nth=-1" }, "wait": 2500 },
  { "caption": { "en": "Search by national ID: the patient fills in", "ar": "البحث بالرقم الوطني: تُملأ بيانات المريض" }, "ms": 2200 },
  { "click": { "selector": "button.field-btn:has-text(\"محلي — داخل ليبيا\")" }, "wait": 800 },
  { "click": { "selector": "button.field-btn:has-text(\"بدون مزوّد\")" }, "wait": 800 },
  { "click": { "selector": "button:text-is(\"التالي\")" }, "wait": 1500 },
  { "caption": { "en": "Step 2 — invoice period and diagnosis", "ar": "الخطوة 2 — فترة الفواتير والتشخيص" }, "ms": 2000 },
  { "fill": { "selector": "#ce-order-id" }, "value": "INV-DEMO-${RUN}" },
  { "fill": { "selector": "#ce-order-start" }, "value": "2026-12-01" },
  { "fill": { "selector": "#ce-order-end" }, "value": "2026-12-31" },
  { "fill": { "placeholder": "مثال: N18.6" }, "value": "J06.9" },
  { "fill": { "selector": "textarea" }, "value": "التهاب حاد في الجهاز التنفسي العلوي — حالة تجريبية" },
  { "click": { "selector": "button:text-is(\"التالي\")" }, "wait": 1500 },
  { "caption": { "en": "Step 3 — add the invoice and its services", "ar": "الخطوة 3 — أضف الفاتورة وخدماتها" }, "ms": 2000 },
  { "click": { "selector": "button:has-text(\"إضافة فاتورة\")" }, "wait": 800 },
  { "fill": { "selector": "#csi-1-number" }, "value": "INV-DEMO-${RUN}" },
  { "fill": { "selector": "#csi-1-date" }, "value": "2026-12-15" },
  { "fill": { "selector": "#csi-1-total" }, "value": "150" },
  { "click": { "selector": "button.csi-save" }, "wait": 1200 },
  { "click": { "selector": "button:has-text(\"إضافة خدمة\")" }, "wait": 1500 },
  { "fill": { "label": "الخدمة (عربي)" }, "value": "استشارة طبية عامة" },
  { "fill": { "label": "الخدمة (إنجليزي)" }, "value": "General medical consultation" },
  { "fill": { "label": "المبلغ الأصلي" }, "value": "150" },
  { "fill": { "label": "المبلغ المرفوض" }, "value": "0" },
  { "caption": { "en": "Add the service: name and amounts", "ar": "أضف الخدمة: الاسم والمبالغ" }, "ms": 2600 },
  { "click": { "selector": "app-service-line-dialog button:text-is(\"حفظ\")" }, "wait": 2000 },
  { "click": { "selector": "button:text-is(\"التالي\")" }, "wait": 1500 },
  { "caption": { "en": "Step 4 — save the claim; it goes to review", "ar": "الخطوة 4 — احفظ المطالبة؛ تنتقل للمراجعة" }, "ms": 2000 },
  { "click": { "selector": "button:text-is(\"حفظ المطالبة\")" }, "wait": 4000 },
  { "capture": "BATCH_ID", "pattern": "batches/(\\d+)" },
  { "clearCaption": true }
] }
